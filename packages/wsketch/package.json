{
  "name": "@rem-aster/wsketch",
  "version": "0.1.0",
  "description": "Turns a hand-drawn whiteboard stroke into a clean shape: line, arrow, rectangle, ellipse, triangle, diamond, pentagon, hexagon",
  "keywords": [
    "whiteboard",
    "sketch",
    "ink",
    "stroke",
    "shape recognition",
    "beautification",
    "onnx"
  ],
  "license": "Apache-2.0",
  "author": "rem-aster",
  "homepage": "https://github.com/rem-aster/wsketch/tree/main/packages/wsketch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rem-aster/wsketch.git",
    "directory": "packages/wsketch"
  },
  "bugs": "https://github.com/rem-aster/wsketch/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model.onnx": "./dist/shapes.int8.onnx",
    "./model.json": "./dist/shapes.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun scripts/build.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "onnxruntime-web": "^1.31.1",
    "typescript": "~6.0.3"
  }
}
